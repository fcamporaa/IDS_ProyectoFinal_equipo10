# =============================================================================
# Cine Paradiso - Plantilla de Entorno (.env.example) para Docker Compose
# =============================================================================
# Para levantar con Docker: copiar este archivo a .env en la raíz del proyecto:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de Datos MySQL (Contenedor 'db' e interfaz del Backend)
# -----------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
DB_NAME=proyecto_integrador
DB_SSL=false

# Puerto expuesto hacia la máquina host (ej. DBeaver o Workbench)
DB_PORT_EXTERNAL=3307

# -----------------------------------------------------------------------------
# 2. Backend (API REST)
# -----------------------------------------------------------------------------
BACKEND_PORT=5000

# Clave secreta criptográfica (mínimo 32 caracteres) para firmar tokens JWT
JWT_SECRET_KEY=cambiar_por_clave_secreta_jwt_de_al_menos_32_caracteres_aleatoria

JWT_ACCESS_TOKEN_MINUTES=120

# Clave de API para OMDb (Obtener en https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Habilita pasarela de pago simulada para entorno de pruebas/evaluación (true / false)
ALLOW_SIMULATED_PAYMENTS=true

# -----------------------------------------------------------------------------
# 3. Envío de Correos Electrónicos (Comprobantes y Tokens QR)
# Modos disponibles:
#   - smtp: Envía emails reales vía servidor SMTP (ej. Gmail, Outlook)
#   - console: Imprime el correo en la consola del backend sin requerir credenciales
# -----------------------------------------------------------------------------
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# -----------------------------------------------------------------------------
# 4. Frontend (Servidor Web SSR Flask + Jinja2)
# -----------------------------------------------------------------------------
PORT=5001
FRONTEND_PORT=5001
FLASK_DEBUG=False

# URL interna para comunicarse con el Backend dentro de la red Docker
BACKEND_URL=http://backend:5000

# Clave secreta (mínimo 32 caracteres) para firmar cookies de sesión en el navegador
SECRET_KEY=cambiar_por_clave_secreta_frontend_de_al_menos_32_caracteres
FRONTEND_SECRET_KEY=cambiar_por_clave_secreta_frontend_de_al_menos_32_caracteres
