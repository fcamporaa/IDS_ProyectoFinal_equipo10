DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_integrador

JWT_ACCESS_TOKEN_MINUTES=60
JWT_SECRET_KEY=
OMDB_API_KEY=

# Una clave aleatoria de >= 32 caracteres, compartida solo con el emisor de tokens de US-02.
# Solo desarrollo: NO representa una transacción bancaria real.
ALLOW_SIMULATED_PAYMENTS=false
# console = NO enviar, smtp = correo real (requiere configuración y qrcode instalado).
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

